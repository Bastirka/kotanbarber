# Postgres connection string (Vercel Postgres, Neon, Supabase — any Postgres works)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Random string of your choosing — must match what you pass to `npm run set-webhook`
TELEGRAM_WEBHOOK_SECRET=

# Your personal Telegram numeric user id (or a group chat id) — the shop gets
# "new booking" / "cancelled" notifications here. Get it from @userinfobot.
ADMIN_CHAT_ID=

# Password for the /admin panel — put it in the "Admin tokens" field there.
ADMIN_TOKEN=

# Used only by `npm run set-webhook` locally, not read by the app itself.
PUBLIC_URL=https://your-project.vercel.app
